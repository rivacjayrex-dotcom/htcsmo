<mxCell id="note3" value="Process numbers identify functions, not execution order. Deadline policy: three working days; warning and overdue checks belong to process 8.0." style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#ffffff;fontFamily=Arial;fontSize=21;" vertex="1" parent="1"><mxGeometry x="50" y="2155" width="2900" height="35" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>